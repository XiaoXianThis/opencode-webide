# Bun BFF listen port
PORT=3000

# Upstream opencode serve
OPENCODE_URL=http://127.0.0.1:4096

# Bun BFF listen host. Use 0.0.0.0 for containers or remote access.
HOST=127.0.0.1

# WebIDE token auth. Leave empty to disable auth for local development.
WEBIDE_TOKEN=

# Basic Auth credentials for opencode (set OPENCODE_SERVER_PASSWORD when starting opencode serve)
OPENCODE_USERNAME=opencode
OPENCODE_PASSWORD=
